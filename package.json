{
  "name": "geekcode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "predev": "npm run content:generate",
    "build": "npm run content:generate && npm run validate-content && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:generate": "node scripts/collect-content.mjs && tsx scripts/generate-content.ts",
    "validate-content": "tsx scripts/validate-content.ts",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "postinstall": "npm run prepare:runtime"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dexie": "^4.0.11",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "minisearch": "^7.1.2",
    "monaco-editor": "^0.52.2",
    "monaco-vim": "^0.4.0",
    "pyodide": "0.27.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.13.0",
    "typescript": "~5.7.3",
    "yaml": "^2.7.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "$katex"
  }
}
